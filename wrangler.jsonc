{
  // Configuração do Cloudflare Workers. O deploy a partir do GitHub lê este arquivo.
  "name": "atmosfera",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["python_workers"],

  // Páginas estáticas (public/). Só as rotas /api/* passam pelo código Python.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Variáveis não secretas. O segredo SESSION_SECRET é cadastrado no painel da Cloudflare.
  "vars": {
    "FIRESTORE_PROJECT_ID": "atmosfera-f4c87",
    "FIRESTORE_COLLECTION": "users",
    "WEATHER_CACHE_SECONDS": "300"
  }
}
